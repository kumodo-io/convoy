{
  "packages": {
    ".": {
      "release-type": "go",
      "bump-minor-pre-major": true,
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "extra-files": [
        { "type": "generic", "path": "deploy/kustomization/default/kustomization.yaml"},
        { "type": "yaml", "path": "deploy/chart/convoy/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "deploy/chart/convoy/Chart.yaml", "jsonpath": "$.appVersion" }
      ]
    }
  },
  "pull-request-header": ":robot: Release ready",
  "changelog-sections": [
    { "type": "feat", "section": "Features", "hidden": false },
    { "type": "fix", "section": "Bug Fixes", "hidden": false },
    { "type": "chore", "section": "Miscellaneous", "hidden": false },
    { "type": "aux", "hidden": true }
  ]
}
